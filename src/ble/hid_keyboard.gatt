// GATT database for CMK — Composite HID Peripheral (Keyboard + Mouse)

// Generic Access Service
PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, DYNAMIC | READ,
CHARACTERISTIC, GAP_APPEARANCE, READ, 0xC1, 0x03

// Battery Service
#import <battery_service.gatt>

// Device Information Service
#import <device_information_service.gatt>

// HID Service — composite: keyboard (Report ID 1) + mouse (Report ID 2)
// Inline instead of #import <hids.gatt> because the standard template
// only provides ONE Input Report characteristic.
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_HUMAN_INTERFACE_DEVICE
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_PROTOCOL_MODE, DYNAMIC | READ | WRITE_WITHOUT_RESPONSE,

// Input Report 1: Keyboard (8 bytes: modifier, reserved, 6 keycodes)
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | NOTIFY | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 1, 1

// Input Report 2: Mouse (6 bytes: buttons, X int16, Y int16, wheel int8)
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | NOTIFY | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 2, 1

// Input Report 3: Programmable Buttons (4 bytes: 32-bit bitmask)
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | NOTIFY | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 3, 1

// Input Report 4: Consumer Control (2 bytes: one 16-bit consumer usage — bug #6)
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | NOTIFY | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 4, 1

// Output Report 1: Keyboard LED indicators
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | WRITE_WITHOUT_RESPONSE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 1, 2

// Feature Report 1
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT, DYNAMIC | READ | WRITE | ENCRYPTION_KEY_SIZE_16,
REPORT_REFERENCE, READ, 1, 3

CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_REPORT_MAP, DYNAMIC | READ,
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_BOOT_KEYBOARD_INPUT_REPORT, DYNAMIC | READ | WRITE | NOTIFY,
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_BOOT_KEYBOARD_OUTPUT_REPORT, DYNAMIC | READ | WRITE | WRITE_WITHOUT_RESPONSE,
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_BOOT_MOUSE_INPUT_REPORT, DYNAMIC | READ | WRITE | NOTIFY,
// bcdHID = 0x101 (v1.0.1), bCountryCode 0, flags = normally connectable
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_HID_INFORMATION, READ, 01 01 00 02
CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_HID_CONTROL_POINT, DYNAMIC | WRITE_WITHOUT_RESPONSE,

// CMK-Split Service (Phase 18) — inter-half raw matrix transport for the runtime
// split. Exposed ALWAYS (both halves compile it identically → stable DB hash); the
// runtime role (MASTER/SLAVE/STANDALONE) is decided by who subscribes/discovers it.
//   matrix_event    NOTIFY        1B  bit7=pressed, bits5:3=row, bits2:0=col
//   matrix_snapshot READ+NOTIFY   3B  24-bit pressed bitmap (re-sync)
//   side_id         READ          1B  board_side_get() (0=Left, 1=Right)
//   split_mode      READ+NOTIFY   1B  eeconfig split_mode of this half (strict matching)
//   rgb_sync        WRITE(_NR)  ≤16B  MASTER→SLAVE RGB effect state + hits (Phase 24)
PRIMARY_SERVICE, c3a50001-7a4e-4c1b-9b21-000000000001
CHARACTERISTIC, c3a50002-7a4e-4c1b-9b21-000000000001, DYNAMIC | NOTIFY,
CHARACTERISTIC, c3a50003-7a4e-4c1b-9b21-000000000001, DYNAMIC | READ | NOTIFY,
CHARACTERISTIC, c3a50004-7a4e-4c1b-9b21-000000000001, DYNAMIC | READ,
CHARACTERISTIC, c3a50005-7a4e-4c1b-9b21-000000000001, DYNAMIC | READ | NOTIFY,
CHARACTERISTIC, c3a50006-7a4e-4c1b-9b21-000000000001, DYNAMIC | WRITE | WRITE_WITHOUT_RESPONSE,

// Power activity/control v1 (20 B), independent of RGB and matrix transport.
// Append after existing split chars: existing HID/split value handles stay stable.
CHARACTERISTIC, c3a50010-7a4e-4c1b-9b21-000000000001, DYNAMIC | READ | WRITE | WRITE_WITHOUT_RESPONSE | NOTIFY | ENCRYPTION_KEY_SIZE_16,

// peer_batt (bug #3): this half's battery SoC, 1 B (0..100, 0xFF = unknown).
// READ only — the central polls it; appended last so earlier handles stay put.
CHARACTERISTIC, c3a50007-7a4e-4c1b-9b21-000000000001, DYNAMIC | READ,

// GATT Service (required for database hash)
PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,
